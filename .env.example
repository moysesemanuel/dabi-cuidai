# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção). Nunca coloque valores reais no git.

# Banco (Neon): use a connection string "pooled". Em desenvolvimento, pode usar PGHOST/PGDATABASE/PGUSER no lugar.
DATABASE_URL=

# Chaves de push: gere com `npx web-push generate-vapid-keys`. Use chaves NOVAS em produção.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exibido aos serviços de push, no formato mailto:seu@email.com
VAPID_SUBJECT=

# Upstash QStash: chaves de assinatura (console do Upstash > QStash). Servem para o servidor aceitar só chamadas deles.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Opcional: segredo para chamar /api/cron/dispatch à mão (curl -H "Authorization: Bearer ...").
CRON_SECRET=
